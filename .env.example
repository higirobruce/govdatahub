# Backend Configuration
NODE_ENV=development
PORT=3001
CORS_ORIGIN=http://localhost:3000

# Metadata Database (PostgreSQL)
DB_HOST=localhost
DB_PORT=5432
DB_USERNAME=admin
DB_PASSWORD=admin123
DB_DATABASE=datagate

# Security
# Generate ENCRYPTION_KEY with: openssl rand -hex 32 (must be 64 hex chars / 32 bytes)
ENCRYPTION_KEY=
# Generate JWT_SECRET with: openssl rand -hex 32
JWT_SECRET=
JWT_EXPIRATION=7d

# Rate Limiting
THROTTLE_TTL=60000
THROTTLE_LIMIT=30
QUERY_THROTTLE_LIMIT=10

# Query Settings
QUERY_TIMEOUT_MS=30000
MAX_RESULT_ROWS=10000

# Frontend Configuration
NEXT_PUBLIC_API_URL=http://localhost:3001/api

# Transformation Settings
TRANSFORMATION_TIMEOUT_MS=300000
TRANSFORMATION_RETENTION_DAYS=90

# Cross-Query Settings
CROSS_QUERY_TIMEOUT_MS=30000
CROSS_QUERY_MAX_ROWS=10000

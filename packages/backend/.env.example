# Backend Configuration
NODE_ENV=development
PORT=3001
CORS_ORIGIN=http://localhost:3000

# Metadata Database (PostgreSQL)
DB_HOST=localhost
DB_PORT=5432
DB_USERNAME=admin
DB_PASSWORD=admin123
DB_DATABASE=datagate

# Security
# Generate ENCRYPTION_KEY with: openssl rand -hex 32 (must be 64 hex chars / 32 bytes)
ENCRYPTION_KEY=
# Generate JWT_SECRET with: openssl rand -hex 32
JWT_SECRET=
JWT_EXPIRATION=7d

# Rate Limiting
THROTTLE_TTL=60000
THROTTLE_LIMIT=30
QUERY_THROTTLE_LIMIT=10

# Query Settings
QUERY_TIMEOUT_MS=30000
MAX_RESULT_ROWS=10000

# Cross-Query Settings
CROSS_QUERY_TIMEOUT_MS=30000
CROSS_QUERY_MAX_ROWS=10000
CROSS_QUERY_MAX_TABLES=10
CROSS_QUERY_MAX_JOINS=8
FDW_CLEANUP_INTERVAL_MS=3600000

# Transformation Settings
TRANSFORMATION_TIMEOUT_MS=300000
TRANSFORMATION_RETENTION_DAYS=90

# AI Settings
AI_TIMEOUT_MS=120000 # Timeout (ms) for AI provider HTTP calls (NL2SQL, generateJson, embeddings)
EMBEDDINGS_MODEL=bge-m3 # Ollama embeddings model used by EmbeddingsService

# Entity matching
MATCHING_RETENTION_DAYS=30 # Default days a match project's workspace/candidates are retained before the sweep deletes them
MATCHING_MAX_CANDIDATE_PAIRS=250000000 # Blocking estimate refuses a run projecting more than this many candidate pairs
MATCHING_BATCH_ROWS=50000 # Row batch size used when materializing a match project's workspace table
